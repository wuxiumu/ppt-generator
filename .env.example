# Copy this file to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# Default model provider. Leave blank until you have a key from
# https://platform.deepseek.com — the placeholder is not a secret and will not work.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional. Qwen uses an Anthropic-compatible endpoint (`--provider qwen`).
# QWEN_API_KEY=
# QWEN_BASE_URL=https://coding.dashscope.aliyuncs.com/apps/anthropic
# QWEN_MODEL=qwen3.7-plus

# Optional (`--provider openai`).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Web admin. Change both before any shared or client demo.
# If these are unset, the app falls back to admin / admin888.
ADMIN_USER=admin
ADMIN_PASS=change-me-before-demo

# Optional signing secret. If empty, the process generates a random one at startup.
SECRET_KEY=

# Optional. Used only by the comic image pipeline, not by slide generation.
# DASHSCOPE_API_KEY=
# SILICONFLOW_API_KEY=
